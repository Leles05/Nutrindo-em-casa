# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service role): SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mercado Pago =====
# Painel: Suas integrações > sua aplicação. Credenciais de TESTE no .env.local;
# as de PRODUÇÃO ficam só como Secret na Vercel. Nunca versione valores reais.
# Chave de acesso: SOMENTE no servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Chave pública: pode ir ao navegador (usada pelo MP.js para transformar o cartão em token, sem passar pelo nosso servidor).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Segredo para validar a assinatura (x-signature) dos avisos de pagamento.
MERCADOPAGO_WEBHOOK_SECRET=

# ===== Renovação automática (rotina diária em vercel.json) =====
# Segredo da rotina /api/cron/renovacoes. A Vercel o envia sozinha como "Authorization: Bearer ...".
# Gere um valor longo e aleatório (ex.: openssl rand -hex 32).
CRON_SECRET=

# ===== E-mails transacionais (acesso, aviso de renovação) =====
# Resend (https://resend.com). Sem a chave, os avisos não são enviados (a cobrança não é afetada).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ===== Site =====
# URL pública usada nos links dos e-mails (ex.: https://nutrindoemcasa.com.br)
NEXT_PUBLIC_SITE_URL=

# ===== Google OAuth (login com Google + Agenda) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Apenas para scripts/reset_and_seed_db.mjs (NUNCA em produção) =====
# SEED_NUTRI_PASSWORD=
# SEED_LUCAS_PASSWORD=
# CONFIRMO_APAGAR_TUDO=SIM
