# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service role): SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Asaas =====
# Sandbox:  https://api-sandbox.asaas.com/v3   |  Produção: https://api.asaas.com/v3
ASAAS_API_URL=
ASAAS_API_KEY=
# Mesmo valor cadastrado como "Token de autenticação" no webhook do painel do Asaas (obrigatório)
ASAAS_WEBHOOK_TOKEN=

# ===== Renovação automática (rotina diária em vercel.json) =====
# Segredo da rotina /api/cron/renovacoes. A Vercel o envia sozinha como "Authorization: Bearer ...".
# Gere um valor longo e aleatório (ex.: openssl rand -hex 32).
CRON_SECRET=

# ===== E-mails transacionais (aviso de renovação, falha de cobrança) =====
# Resend (https://resend.com). Sem a chave, os avisos não são enviados (a cobrança continua funcionando).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ===== Site =====
# URL pública usada nos links dos e-mails (ex.: https://nutrindoemcasa.com.br)
NEXT_PUBLIC_SITE_URL=

# ===== Google OAuth (login com Google + Agenda) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Apenas para scripts/reset_and_seed_db.mjs (NUNCA em produção) =====
# SEED_NUTRI_PASSWORD=
# SEED_LUCAS_PASSWORD=
# CONFIRMO_APAGAR_TUDO=SIM
